{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://winrouter.local/schema/rule-settings-v2.json",
  "title": "WinRouter rule settings v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "initialized", "default_outbound", "rules", "rule_order"],
  "properties": {
    "schema_version": { "const": 2 },
    "initialized": { "type": "boolean" },
    "default_outbound": { "enum": ["a", "b", "c"] },
    "rules": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/rule" } },
    "rule_order": { "type": "array", "maxItems": 1000, "items": { "type": "string" } }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "values", "action", "enabled"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:_-]{0,127}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "type": { "enum": ["domain", "domain-suffix", "ip", "process-name", "process-path"] },
        "values": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "action": { "enum": ["a", "b", "c", "final", "reject"] },
        "enabled": { "type": "boolean" }
      }
    }
  }
}
